{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Compile",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "${config:arduino.defaultBoard}",
        "${config:arduino.defaultSketch}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "upload",
        "-p",
        "${config:arduino.defaultPort}",
        "--fqbn",
        "${config:arduino.defaultBoard}",
        "${config:arduino.defaultSketch}"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
